{
  "name": "aoe2",
  "version": "0.3.206",
  "private": true,
  "type": "module",
  "scripts": {
    "voxel:build": "node scripts/voxel-build-if-stale.mjs",
    "predev": "npm run voxel:build",
    "dev": "vite",
    "playtest": "tsx scripts/playtest.mjs",
    "run-oracles": "tsx scripts/run-oracles.mjs",
    "playtest:corpus": "tsx scripts/playtest-corpus.mjs",
    "playtest:llm": "tsx scripts/playtest-llm.mjs",
    "playtest:corpus-llm": "tsx scripts/playtest-corpus-llm.mjs",
    "playtest:corpus-dashboard": "tsx scripts/playtest-corpus-llm-dashboard.mjs",
    "playtest:findings": "tsx scripts/playtest-findings.mjs",
    "playtest:self-improve": "tsx scripts/playtest-self-improve.mjs",
    "replay:inspect": "tsx scripts/replay-inspect.mjs",
    "ai:trajectory": "tsx scripts/aiTrajectory.mjs",
    "ai:army-block": "tsx scripts/aiArmyBlock.mjs",
    "ai:selfplay-audit": "tsx scripts/selfplay-audit.mjs",
    "ai:tickrate": "tsx scripts/aiTickRate.mjs",
    "ai:gather-walk": "tsx scripts/aiGatherWalk.mjs",
    "prebuild": "npm run voxel:build && node scripts/build-content.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run voxel:build",
    "pretest": "npm run voxel:build",
    "test": "vitest run",
    "pretest:browser": "npm run build",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "test:watch": "vitest",
    "prelint": "npm run voxel:build",
    "lint": "eslint src tests --no-error-on-unmatched-pattern",
    "content:build": "node scripts/build-content.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "content:validate:strict": "node scripts/validate-content.mjs --strict",
    "verify": "npm run content:validate && npm run test && npm run typecheck && npm run test:browser && npm run lint && npm run build",
    "playtest:canary": "tsx scripts/playtest-canary.mjs",
    "ci:status": "node scripts/ci-status.mjs",
    "ai:sweep": "tsx scripts/ai-dark-age-sweep.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "civ-engine": "file:../civ-engine",
    "three": "0.185.1",
    "voxel": "file:../voxel"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@eslint/js": "^9.24.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.14.1",
    "@types/pngjs": "^6.0.5",
    "@types/three": "0.185.0",
    "eslint": "^9.24.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.29.0",
    "vite": "^6.4.3",
    "vitest": "^3.1.2"
  }
}
