{
  "name": "aoe2",
  "version": "0.1.89",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "playtest": "tsx scripts/playtest.mjs",
    "run-oracles": "tsx scripts/run-oracles.mjs",
    "propose-fix": "tsx scripts/propose-fix.mjs",
    "playtest:corpus": "tsx scripts/playtest-corpus.mjs",
    "playtest:llm": "tsx scripts/playtest-llm.mjs",
    "playtest:corpus-llm": "tsx scripts/playtest-corpus-llm.mjs",
    "playtest:corpus-dashboard": "tsx scripts/playtest-corpus-llm-dashboard.mjs",
    "playtest:llm-auto-fix": "tsx scripts/playtest-llm-auto-fix.mjs",
    "playtest:findings": "tsx scripts/playtest-findings.mjs",
    "replay:inspect": "tsx scripts/replay-inspect.mjs",
    "prebuild": "node scripts/build-content.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest:browser": "npm run build",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "test:watch": "vitest",
    "lint": "eslint src tests --no-error-on-unmatched-pattern",
    "content:build": "node scripts/build-content.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "content:validate:strict": "node scripts/validate-content.mjs --strict",
    "verify": "npm run content:validate && npm run test && npm run test:browser && npm run lint && npm run build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "civ-engine": "file:../civ-engine",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@eslint/js": "^9.24.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.14.1",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.24.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.29.0",
    "vite": "^6.2.0",
    "vitest": "^3.1.2"
  }
}
