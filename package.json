  "dependencies": {
    "civ-engine": "file:../civ-engine",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.14.1",
    "eslint": "^9.24.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.29.0",
    "vite": "^6.2.0",
    "vitest": "^3.1.2"
  }
}
